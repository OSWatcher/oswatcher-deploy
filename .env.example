# Copy this file to .env and fill in your values.

# neo4j
NEO4J_VERSION=5.26
NEO4J_AUTH=none
NEO4J_USER=neo4j
NEO4J_PASSWORD=""

# minio
MINIO_VERSION=RELEASE.2025-09-07T16-13-09Z
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# traefik
TRAEFIK_VERSION=3.6.2

# Base domain for production Traefik routing (prod only).
# Frontend is exposed at <DOMAIN>, services at api.<DOMAIN> and storage.<DOMAIN>.
# DOMAIN=example.com

# API — MinIO dedicated read-only user for the API service
# Create with: docker compose exec minio mc admin user add local/ <user> <password>
MINIO_ACCESS_KEY="api-blob-download"
MINIO_SECRET_KEY="change-me"

# Optional: restrict which branch name is surfaced as the primary dataset
# RESTRICTED_BRANCH_NAME=master

# Optional: PostHog analytics (leave empty to disable)
POSTHOG_PROJECT_API_KEY=""

# Optional: API debug logging
# NEO4J_GRAPHQL_DEBUG_LVL="@neo4j/graphql:execution"
