# neo4j
NEO4J_VERSION=5.23
NEO4J_AUTH=none
NEO4J_USER=neo4j
NEO4J_PASSWORD=""
# HEAP_MAXSIZE=4G

# minio
MINIO_VERSION=latest
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# neogit
NEOGIT_OBJECT__PROVIDER="minio"
NEOGIT_OBJECT__KEY="${MINIO_ROOT_USER}"
NEOGIT_OBJECT__SECRET_KEY="${MINIO_ROOT_PASSWORD}"
NEOGIT_OBJECT__HOST="127.0.0.1"
NEOGIT_OBJECT__PORT="9000"
NEOGIT_OBJECT__SECURE=false
