# neo4j
NEO4J_VERSION=5.26
NEO4J_AUTH=none
NEO4J_USER=neo4j
NEO4J_PASSWORD=""
# HEAP_MAXSIZE=4G

# minio
MINIO_VERSION=RELEASE.2025-09-07T16-13-09Z
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# traefik
TRAEFIK_VERSION=3.5.2

# neogit
NEOGIT_OBJECT__PROVIDER="minio"
NEOGIT_OBJECT__KEY="${MINIO_ROOT_USER}"
NEOGIT_OBJECT__SECRET_KEY="${MINIO_ROOT_PASSWORD}"
NEOGIT_OBJECT__HOST="127.0.0.1"
NEOGIT_OBJECT__PORT="9000"
NEOGIT_OBJECT__SECURE=false
# NEOGIT_NEO4J__HOST=""
# NEOGIT_NEO4J__PORT=

# frontend
# VITE_GRAPHEOS_API_URI=""
# VITE_GRAPHEOS_API_URI=""
